{
  "expo": {
    "name": "Parental Screen Tracker",
    "slug": "parental-screen-tracker-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.parental.screentracker"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parental.screentracker"
    },
    "plugins": [
      "expo-asset",
      "expo-status-bar"
    ]
  }
}
