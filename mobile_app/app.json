{
  "expo": {
    "name": "Parental Screen Tracker",
    "slug": "parental-screen-tracker-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "android": {
      "usesCleartextTraffic": true,
      "versionCode": 3,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "package": "com.parental.screentracker"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.parental.screentracker"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER"
    },
    "plugins": [
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "3f41f7bc-512d-472c-a99e-e9551f43803a"
      }
    }
  }
}
